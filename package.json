    ],
    "setupFiles": [
      "./__tests__/helpers/jestSetup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/"
    ],
    "globalSetup": "./__tests__/helpers/globalSetup.js",
    "moduleNameMapper": {
      "\\.db$": "<rootDir>/__tests__/helpers/fileStub.js"
    }
  },
