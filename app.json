{
  "expo": {
    "name": "CPL",
    "description": "This application helps up to pray with biblical texts that the Lord Jesus himself used to pray. Currently it is only available in Catalan.",
    "slug": "CPLApp",
    "version": "9.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon/icon.png",
    "githubUrl": "https://github.com/pausabe/cpl-app",
    "primaryColor": "#ffffff",
    "backgroundColor": "#000000",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "cpl.cpl",
      "buildNumber": "90",
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "cpl.cpl",
      "versionCode": 90,
      "userInterfaceStyle": "automatic",
      "icon": "./src/assets/icon/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon/androidForeground.png",
        "backgroundImage": "./src/assets/icon/androidBackground.png"
      },
      "permissions": []
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Per saber de quina diòcesi ets i triar-la automàticament. La ubicació no surt del telèfon."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#E7F2F1",
          "imageWidth": 184,
          "dark": {
            "image": "./src/assets/splashDark.png",
            "backgroundColor": "#0E1413"
          },
          "android": {
            "imageWidth": 160
          }
        }
      ]
    ]
  }
}
