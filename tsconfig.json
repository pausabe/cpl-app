{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The models are data classes that the services fill in field by field once created: asking for
    // every field to be set in a constructor would mean writing them all again, for nothing the
    // tests do not already check.
    "strictPropertyInitialization": false,
    // TypeScript 6 stops loading @types by itself; the tests need the globals of Jest
    "types": ["jest", "node"]
  }
}
