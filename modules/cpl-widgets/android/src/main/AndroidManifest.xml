<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- The four widgets of the home screen. The system is the only one that talks to them. -->
    <receiver
      android:name="expo.modules.cplwidgets.AraWidget"
      android:exported="false"
      android:label="@string/cw_ara_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/cw_ara_info" />
    </receiver>
    <receiver
      android:name="expo.modules.cplwidgets.AvuiWidget"
      android:exported="false"
      android:label="@string/cw_avui_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/cw_avui_info" />
    </receiver>
    <receiver
      android:name="expo.modules.cplwidgets.HoresWidget"
      android:exported="false"
      android:label="@string/cw_hores_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/cw_hores_info" />
    </receiver>
    <receiver
      android:name="expo.modules.cplwidgets.ParaulaWidget"
      android:exported="false"
      android:label="@string/cw_paraula_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/cw_paraula_info" />
    </receiver>
    <!-- The hour that changes with the clock: the alarm of the next change of hour, and the clock or
         the time zone changed by hand or by the network -->
    <receiver
      android:name="expo.modules.cplwidgets.WidgetClock"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
