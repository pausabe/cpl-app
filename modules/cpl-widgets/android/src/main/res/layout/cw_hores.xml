<?xml version="1.0" encoding="utf-8"?>
<!-- «Les hores»: the day on its liturgical colour and the seven hours, each one a touch away, the
     one to pray now in teal (WidgetViews.hores) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/cw_widget_home"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:id="@+id/cw_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cw_card_day_v"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="13dp"
    android:paddingEnd="15dp"
    android:paddingBottom="13dp">

    <include
      layout="@layout/cw_day"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />
  </LinearLayout>

  <!-- The seven hours in three rows of the same height -->
  <include
    layout="@layout/cw_hours_first"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="10dp"
    android:layout_weight="1" />

  <include
    layout="@layout/cw_hours_middle"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="7dp"
    android:layout_weight="1" />

  <include
    layout="@layout/cw_hours_last"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="7dp"
    android:layout_weight="1" />
</LinearLayout>
