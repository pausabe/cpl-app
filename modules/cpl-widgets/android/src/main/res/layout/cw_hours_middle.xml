<?xml version="1.0" encoding="utf-8"?>
<!-- The middle row of «Les hores», narrower: Tèrcia, Sexta and Nona, centred -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:baselineAligned="false"
  android:orientation="horizontal">

  <LinearLayout
    android:id="@+id/cw_tile_tercia"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/cw_tile"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <ImageView
      android:id="@+id/cw_tile_tercia_icon"
      android:layout_width="19dp"
      android:layout_height="19dp"
      android:importantForAccessibility="no"
      android:src="@drawable/cw_hour_tercia" />

    <TextView
      android:id="@+id/cw_tile_tercia_label"
      style="@style/CplWidgetText.Tile.Compact"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:text="@string/cw_hour_tercia" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/cw_tile_sexta"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="7dp"
    android:layout_weight="1"
    android:background="@drawable/cw_tile"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <ImageView
      android:id="@+id/cw_tile_sexta_icon"
      android:layout_width="19dp"
      android:layout_height="19dp"
      android:importantForAccessibility="no"
      android:src="@drawable/cw_hour_sexta" />

    <TextView
      android:id="@+id/cw_tile_sexta_label"
      style="@style/CplWidgetText.Tile.Compact"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:text="@string/cw_hour_sexta" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/cw_tile_nona"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="7dp"
    android:layout_weight="1"
    android:background="@drawable/cw_tile"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <ImageView
      android:id="@+id/cw_tile_nona_icon"
      android:layout_width="19dp"
      android:layout_height="19dp"
      android:importantForAccessibility="no"
      android:src="@drawable/cw_hour_nona" />

    <TextView
      android:id="@+id/cw_tile_nona_label"
      style="@style/CplWidgetText.Tile.Compact"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:text="@string/cw_hour_nona" />
  </LinearLayout>
</LinearLayout>
