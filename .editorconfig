# EditorConfig helps maintain consistent coding styles across editors and IDEs.
# See https://editorconfig.org for more information.

root = true

# ── Defaults for all files ────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ── JavaScript & TypeScript (including JSX / TSX variants) ────────────────────
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

# ── Python ────────────────────────────────────────────────────────────────────
[*.py]
indent_style = space
indent_size = 2

# ── JSON & config files ───────────────────────────────────────────────────────
[*.{json,jsonc}]
indent_style = space
indent_size = 2

# ── YAML ─────────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# ── Markdown ──────────────────────────────────────────────────────────────────
[*.{md,mdx}]
trim_trailing_whitespace = false
